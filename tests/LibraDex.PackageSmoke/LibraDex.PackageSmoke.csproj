<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LibraDexPackageVersion Condition="'$(LibraDexPackageVersion)' == ''">1.0.0</LibraDexPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibraDex" Version="$(LibraDexPackageVersion)" />
  </ItemGroup>

</Project>
